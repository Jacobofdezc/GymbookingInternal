# ============================================================
# GYMBOOKING INTERNAL — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a Git.
# ============================================================

# -------------------------------------------------------
# SUPABASE — Públicas (safe en cliente y servidor)
# -------------------------------------------------------
# Dónde obtenerlas: Supabase Dashboard → Project Settings → API
# En local: añadir a .env.local
# En Vercel: añadir en Project Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://fuhqldalxqghavnfwjix.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------------------
# SUPABASE — Solo servidor (NUNCA usar NEXT_PUBLIC_)
# -------------------------------------------------------
# La service_role key tiene acceso total a la BD sin RLS.
# Solo debe usarse en Route Handlers y scripts de servidor.
# En Vercel: añadir SOLO como variable de entorno de servidor (sin marcar "client").

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------------------
# APP
# -------------------------------------------------------
# URL pública de la app (usada en emails de invitación)
# En local: http://localhost:3000
# En producción: https://your-domain.vercel.app

NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------
# ORGANIZACIÓN — Bootstrap
# -------------------------------------------------------
# Solo necesario la primera vez para crear la organización y el primer admin.
# Eliminar o dejar vacío después del setup inicial.

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ORG_NAME=GymBooking
BOOTSTRAP_ORG_SLUG=gymbooking
